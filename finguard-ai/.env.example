# V1 approves only the official DeepSeek endpoint. Set these in your shell.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
FINGUARD_ACCESS_TOKEN=
FINGUARD_DB=data/tasks.sqlite3
FINGUARD_MODE=workspace
FINGUARD_RETENTION_HOURS=24
# DEEPSEEK_API_KEY is supported as a server-side alias for LLM_API_KEY.
